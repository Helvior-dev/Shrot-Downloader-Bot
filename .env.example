# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token

# Required: allowed Telegram user IDs (comma separated). An empty list blocks startup.
# Usernames also work but may change; prefer numeric IDs.
# Example with IDs: ALLOWED_USERS=123456789, 987654321
ALLOWED_USERS=

# Optional: HTTP/HTTPS proxy (useful for hosted cloud instances like Render)
# PROXY_URL=http://user:password@proxy-ip:port
PROXY_URL=
